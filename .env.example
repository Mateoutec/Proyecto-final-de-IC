# Asistencia Biométrica v1 — configuración
# scripts/setup.sh crea .env a partir de este archivo y genera las claves vacías.
# Nunca sobrescribe valores que ya existan en tu .env.

# --- Seguridad (se generan solas) ---
ADMIN_PASSWORD=
SESSION_SECRET=
# Clave Fernet para cifrar los embeddings. Si se pierde: uv run python -m app.cli reindex
ENCRYPTION_KEY=

# --- Servidor (siempre escucha en 127.0.0.1) ---
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=data
MODELS_DIR=models
# Zona horaria para mostrar fechas (vacío = la del sistema), p. ej. America/Lima
TIMEZONE=

# --- Reconocimiento facial ---
# insightface (por defecto, solo uso no comercial) | sface (Apache-2.0) | fake (tests)
FACE_ENGINE=insightface
THRESHOLD_INSIGHTFACE=0.45
THRESHOLD_SFACE=0.363
IDENTIFY_MARGIN=0.06
CONSENSUS_WINDOW=5
CONSENSUS_REQUIRED=3
MAX_IDENTIFY_FRAMES=15

# --- Calidad por frame ---
MIN_FACE_RATIO=0.14
MIN_SHARPNESS=25
MIN_BRIGHTNESS=60
MAX_BRIGHTNESS=215
MAX_FRONTAL_YAW=0.15
MAX_ROLL_DEGREES=20

# --- Prueba de vida (giro de cabeza) ---
LIVENESS_ENABLED=true
LIVENESS_TIMEOUT_SECONDS=7
LIVENESS_YAW_THRESHOLD=0.18
# true solo si tu cámara entrega frames ya espejados
CAMERA_FRAMES_MIRRORED=false

# --- Asistencia ---
DEBOUNCE_SECONDS=120
MAX_SHIFT_HOURS=16
SAVE_FAILED_ATTEMPTS=false
# face (rostro 1:N) | code_plus_face (código de estudiante + rostro 1:1)
FALLBACK_MODE=face

# --- Huella (v2) ---
# disabled | simulated | as608 (experimental)
FINGERPRINT_PROVIDER=disabled
FINGERPRINT_PORT=/dev/tty.usbserial-0001
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_HIGH_SCORE=100
FINGERPRINT_MEDIUM_SCORE=40
FINGERPRINT_SCAN_TIMEOUT=8

# --- Exportación ---
CSV_DELIMITER=,
